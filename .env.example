# MongoDB connection string. A mongodb+srv:// URI is preferred; src/config/db.js
# rebuilds it as a plain mongodb:// seed list if SRV lookups are unavailable.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional: alternative name used by some hosts (Vercel). Read as a fallback.
# MONGODB_URI=

PORT=8080

# Optional: resolvers used when the OS/local DNS agent cannot answer the SRV/TXT
# lookups that mongodb+srv:// requires. Defaults to 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------------------
# Admin authentication (JWT)
# ---------------------------------------------------------------------------
# Required by src/utils/jwt.js - use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-string
# Any value accepted by jsonwebtoken: 15m, 12h, 7d...
JWT_EXPIRES_IN=1d

# Optional: id of the profile document the public portfolio reads.
# Falls back to the first document in the `about` collection.
# ABOUT_ID=69b7b3deae50c7eb975112fd

# ---------------------------------------------------------------------------
# Seeder (`npm run seed`) - creates/updates the first admin account and
# imports the projects that used to be hardcoded in the frontend.
# ---------------------------------------------------------------------------
ADMIN_NAME=Portfolio Admin
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin12345
SEED_PROJECTS=true
SEED_EXPERIENCE=true

